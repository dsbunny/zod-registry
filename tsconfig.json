{
	"compilerOptions": {
		"target": "esnext",
		"module": "nodenext",
		"strict": true,
		"esModuleInterop": true,
		"rootDir": "./src",
		"outDir": "./dist",
		"moduleResolution": "nodenext",
		"resolveJsonModule": true,
		"forceConsistentCasingInFileNames": true,
		"noImplicitReturns": true,
		"noUnusedLocals": false,
		"sourceMap": true,
		"skipLibCheck": true,
		"declaration": true,
		"declarationMap": true,
		"types": ["node"]
	},
	"include": [
		"src/**/*.ts"
	],
	"exclude": [
		"node_modules",
		"test"
	]
}
